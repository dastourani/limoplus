{
  "expo": {
    "name": "لیمو پلاس",
    "slug": "limoplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.limoplus.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ir.limoplus.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "limoplus",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/vazirmatn/400Regular/Vazirmatn_400Regular.ttf",
            "./node_modules/@expo-google-fonts/vazirmatn/700Bold/Vazirmatn_700Bold.ttf",
            "./node_modules/@expo-google-fonts/vazirmatn/800ExtraBold/Vazirmatn_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/vazirmatn/900Black/Vazirmatn_900Black.ttf"
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
