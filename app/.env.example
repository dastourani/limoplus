# تنظیمات اپ لیموخوان
# این فایل را با نام .env در همین پوشه کپی کنید.
#
# آدرس سرور — هنگام انتقال به سرور اصلی فقط همین خط عوض می‌شود.
#   نسخه‌ی وب روی همین کامپیوتر:  http://localhost:8000
#   گوشی در همان Wi-Fi:           http://IP-کامپیوتر-شما:8000   (مثلاً http://192.168.1.20:8000)
#   سرور اصلی:                    https://api.limookhan.ir
EXPO_PUBLIC_API_URL=http://localhost:8000
