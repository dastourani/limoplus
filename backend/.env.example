# تنظیمات سرور لیموخوان
# این فایل را با نام .env در همین پوشه کپی کنید و مقدارها را پر کنید.
# فایل .env هرگز داخل GitHub نمی‌رود.

# --- عمومی ---
# یک رشته‌ی تصادفی و طولانی؛ با این دستور بسازید:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# روی سیستم خودتان True، روی سرور اصلی حتماً False
DEBUG=True
# کلید رمزنگاری کد ورود و توکن‌ها. خالی = همان SECRET_KEY.
# اگر عوض شود همه‌ی کاربران خارج می‌شوند؛ پس فقط یک‌بار تنظیمش کنید.
HASH_KEY=

# --- دامنه: هنگام انتقال به سرور فقط همین دو خط عوض می‌شود ---
# روی سیستم خودتان: localhost:8000 ؛ روی سرور: مثلاً api.limookhan.ir
SITE_DOMAIN=localhost:8000

# سایت معرفی (limookhan.ir): روی این دامنه‌ها سایت در ریشه باز می‌شود؛ جای دیگر زیر /site/ است.
#   مثال: WEBSITE_HOSTS=limookhan.ir,www.limookhan.ir
WEBSITE_HOSTS=
# آدرس نسخه‌ی وب اپ، برای دکمه‌های «ورود» و «شروع» سایت. خالی یا / یعنی همین سرور.
#   مثال: APP_URL=https://app.limookhan.ir
APP_URL=/
# روی سیستم خودتان http ؛ روی سرور https
SITE_SCHEME=http

# آدرس‌هایی که نسخه‌ی وب اپ از آن‌ها به سرور وصل می‌شود (با کاما جدا کنید)
# روی سیستم خودتان: http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081

# آدرس پنل مدیر. روی سرور اصلی چیزی بگذارید که فقط خودتان بدانید، مثلاً manage-7f3k
ADMIN_URL=admin

# فرم عمومی درخواست همکاری آموزشی: سقف ثبت از هر IP و هر شماره در یک ساعت
TEACHER_APPLICATIONS_PER_IP_PER_HOUR=5
TEACHER_APPLICATIONS_PER_PHONE_PER_HOUR=1

# تعداد پراکسی‌ها (مثل nginx) جلوی سرور. روی سیستم خودتان 0، پشت یک nginx عدد 1
TRUSTED_PROXY_COUNT=0

# --- دیتابیس ---
# در Docker همین مقدار درست است. خالی بگذارید تا SQLite محلی استفاده شود.
DATABASE_URL=postgres://limoplus:limoplus@db:5432/limoplus

# --- پیامک ---
# console: کد ورود فقط در لاگ سرور چاپ می‌شود (برای تست)
# raygan: ارسال واقعی با رایگان اس‌ام‌اس
SMS_BACKEND=console
RAYGAN_USERNAME=
RAYGAN_PASSWORD=
# شماره‌ی خط فرستنده در پنل رایگان اس‌ام‌اس
RAYGAN_SENDER_NUMBER=
# کد ورود با «الگو»ی تأییدشده‌ی رایگان‌اس‌ام‌اس (از خط خدماتی؛ بی‌نیاز از اینماد). هر دو پر باشد = کدها با الگو می‌روند.
# متن الگو در پنل رایگان‌اس‌ام‌اس است و کد در token1 می‌نشیند. کد دسترسی را در پنل رایگان‌اس‌ام‌اس می‌سازید.
RAYGAN_ACCESS_HASH=
RAYGAN_OTP_PATTERN_ID=
# «خبر دادن به منتظران» در پنل (یک پیامک به هر کسی که «خبرم کن» زده، بعد از صفحه‌ی تأیید). تا True نشود پیامکی نمی‌رود.
WAITLIST_SMS_ENABLED=False
# خط آخر پیامک ورود (کد کوتاه اپ) تا گوشی کد را خودش بخواند. اگر پیامک‌ها نرسید False کنید.
OTP_SMS_APP_HASH=True

# --- پرداخت زیبال ---
# تا رسیدن کد مرچنت واقعی، مقدار zibal (مرچنت آزمایشی زیبال) بماند
ZIBAL_MERCHANT=zibal
# خرید روشن؟ تا کد مرچنت واقعی نرسیده، روی سرور اصلی False بگذارید (دکمه‌ی پرداخت پیام «به‌زودی» می‌دهد)
PAYMENTS_ENABLED=True
# بعد از پرداخت کاربر به این آدرس برمی‌گردد (لینک اپ). برای نسخه‌ی وب: آدرس وب‌اپ + /payment-result
APP_RETURN_URL=limookhan://payment-result

# --- نشست‌ها ---
# حداکثر تعداد دستگاه هم‌زمان برای هر حساب
MAX_ACTIVE_SESSIONS=2
# اعتبار ورود هر دستگاه (روز)
SESSION_TOKEN_DAYS=60

# --- فایل‌های آپلودشده ---
# پوشه‌ی عکس‌ها و فایل‌های آپلودی. روی پارس‌پک: مسیر دیسک ماندگار، مثلاً /opt/app-root/data/media
# MEDIA_ROOT=
# وقتی nginx جلوی سرور نیست (پارس‌پک PaaS) True تا خود برنامه این فایل‌ها را بدهد
SERVE_MEDIA=False

# --- پشتیبان‌گیری ---
# پوشه‌ی پشتیبان‌ها. روی پارس‌پک: /opt/app-root/data/backups
# BACKUP_DIR=
# ربات بله برای فرستادن پشتیبان‌ها: توکن را از @BotFather در بله بگیرید؛ شناسه‌ی گفت‌وگوی خودتان با ربات
BALE_BOT_TOKEN=
BALE_CHAT_ID=
# روش ارسال پشتیبان‌ها:
#   bale_chunks     = ارسال مستقیم/تکه‌تکه فقط به بله (پیش‌فرض فعلی)
#   object_storage  = آپلود فقط به فضای ابری S3 (مثل پارس‌پک)
#   both            = ارسال هم‌زمان به فضای ابری S3 و بله
BACKUP_STORAGE_MODE=bale_chunks
# تنظیمات فضای ابری S3 (پارس‌پک / آروان) — هر وقت باکت را ساختید پر کنید
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=limoplus-backups
BACKUP_S3_KEEP=30
# فقط روی سرور اصلی True: هر ساعت کارهای وقت‌رسیده (پاک‌سازی، پشتیبان شبانه‌ی دیتابیس، پشتیبان هفتگی عکس‌ها)
NIGHTLY_JOBS=False

# --- همگام‌سازی خودکار نسخه‌های اپ از گیتهاب ---
# رمز مشترک بین GitHub Actions (X-Release-Secret) و وب‌هوک /api/v1/releases/sync-github/
RELEASE_WEBHOOK_SECRET=
